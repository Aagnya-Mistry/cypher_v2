# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase > Project Settings > Data API (or the "Connect" button): Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Only for older Supabase projects that still sign logins with the legacy shared secret
# (Project Settings > JWT Keys > Legacy JWT Secret). Leave empty on new projects.
SUPABASE_JWT_SECRET=

# Where the frontend runs; the only site allowed to call this API from a browser
FRONTEND_ORIGIN=http://localhost:5173

# Added later for the agents
GROQ_API_KEY=
