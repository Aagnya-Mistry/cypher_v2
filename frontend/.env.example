# Copy to frontend/.env and fill in. Never commit the real .env.
# Both values are designed to be public (they end up in the browser). The service_role / secret key must NEVER go here.

# Supabase > Project Settings > Data API (or the "Connect" button): Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys: the "publishable" key (called "anon public" on older projects)
VITE_SUPABASE_PUBLISHABLE_KEY=
